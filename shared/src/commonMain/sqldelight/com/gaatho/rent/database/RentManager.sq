CREATE TABLE property (
    id TEXT NOT NULL PRIMARY KEY,
    owner_id TEXT NOT NULL,
    name TEXT NOT NULL,
    address TEXT NOT NULL,
    image_url TEXT,
    property_type TEXT NOT NULL DEFAULT 'HOUSE',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

insertProperty:
INSERT OR REPLACE INTO property (id, owner_id, name, address, image_url, property_type, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllProperties:
SELECT * FROM property;

selectPropertiesByOwner:
SELECT * FROM property WHERE owner_id = ?;

deleteProperty:
DELETE FROM property WHERE id = ?;

-- ─────────────────────────────────────────────────────────────────────────────
-- App Settings: generic key-value store for local app state (e.g. guest_id)
-- ─────────────────────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS app_settings (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

upsertSetting:
INSERT OR REPLACE INTO app_settings (key, value) VALUES (?, ?);

selectSetting:
SELECT value FROM app_settings WHERE key = ?;

deleteSetting:
DELETE FROM app_settings WHERE key = ?;


